# For docker-compose.yml. Copy to a file named .env (next to docker-compose.yml) and fill it in.
DB_PASSWORD=choose-a-strong-database-password
JWT_SECRET=put-a-random-text-of-at-least-32-characters-here
OWNER_USERNAME=owner
OWNER_PASSWORD=choose-a-long-unique-password
OWNER_PHONE=01000000000
CORS_ORIGINS=https://your-app-address.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
