{
  "expo": {
    "name": "أطلب أبيس",
    "slug": "agon-preview",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otlobabis.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00211A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.otlobabis.app",
      "versionCode": 3,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "أطلب أبيس",
      "backgroundColor": "#00211A",
      "themeColor": "#00211A"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00211A"
    },
    "scheme": "otlobabis",
    "plugins": [
      "expo-secure-store"
    ]
  }
}