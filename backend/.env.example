# Copy this file to backend/.env and fill it in. NEVER commit the real .env.

# --- Database ---
# Local PostgreSQL on this computer:
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/otlob
# A local database has no SSL, so turn it off. (Remove this line for Neon / any hosted database.)
DATABASE_SSL=false

# --- Security ---
# Any random text of 32+ characters (change it and every user is signed out)
JWT_SECRET=put-a-random-text-of-at-least-32-characters-here
# The app owner: logs in from the app with OWNER_PHONE + OWNER_PASSWORD (created on the first start)
OWNER_USERNAME=owner
OWNER_PASSWORD=choose-a-long-unique-password
OWNER_PHONE=01000000000

# --- Web ---
# The exact address the web app is opened from (no trailing slash). Several: separate with commas.
CORS_ORIGINS=https://your-app-address.example
PORT=4000
NODE_ENV=production

# --- Phone notifications (Web Push) ---
# Generate once with:  npx web-push generate-vapid-keys   then paste both keys here. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
