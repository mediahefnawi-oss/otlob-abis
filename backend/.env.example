# Copy to .env for local runs. On Render set these in Environment (never commit real values).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=put-a-random-string-of-at-least-32-characters-here
OWNER_USERNAME=owner
OWNER_PASSWORD=choose-a-long-unique-password
# The owner logs in with this phone number + OWNER_PASSWORD from the app's login screen.
OWNER_PHONE=01004379508
CORS_ORIGINS=https://your-project.vercel.app
PORT=4000
